# Copy this file to .kamal/secrets and replace the placeholders locally.
# Never commit real credentials.
KAMAL_REGISTRY_PASSWORD=replace-me
ADMIN_PASS=replace-me
ADMIN_USER=replace-me
CLERK_SECRET_KEY=replace-me
DATABASE_URL=postgresql://application:replace-me@finance-db:5432/application_production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-me
CLERK_PUBLISHABLE_KEY=replace-me
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-me
RECAPTCHA_SECRET_KEY=replace-me
RESEND_API_KEY=replace-me
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_BUCKET=replace-me
STORAGE_ENDPOINT=replace-me
STORAGE_FORCE_PATH_STYLE=false
STORAGE_REGION=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_TOKEN=replace-me
POSTGRES_PASSWORD=replace-me
