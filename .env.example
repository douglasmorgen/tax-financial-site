# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tax_financial_app"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/portal/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/portal/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/portal"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/portal"

# Optional Clerk proxy/origin settings
# CLERK_PROXY_URL="https://example.com/__clerk"
# NEXT_PUBLIC_CLERK_PROXY_URL="https://example.com/__clerk"
# CLERK_AUTHORIZED_PARTIES="https://example.com"

# Admin HTTP Basic Auth
ADMIN_USER="admin"
ADMIN_PASS="replace-with-a-long-random-password"

# Private S3-compatible storage
STORAGE_BUCKET="replace-me"
STORAGE_REGION="us-west-2"
STORAGE_ACCESS_KEY_ID="replace-me"
STORAGE_SECRET_ACCESS_KEY="replace-me"
# STORAGE_ENDPOINT="https://replace-me.example.com"
STORAGE_FORCE_PATH_STYLE="false"
# STORAGE_KMS_KEY_ID="replace-me"

# Contact form (required for successful submissions)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="replace-me"
RECAPTCHA_SECRET_KEY="replace-me"

# Optional contact email delivery
# RESEND_API_KEY="re_replace_me"
